# ==========================================
# ChurnGuard MLOps Project .gitignore
# ==========================================

# --- Python & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.coverage
htmlcov/
*.log

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
dist/
build/
*.egg-info/

# --- Databases & Local State ---
churnguard.db
mlflow.db
mlruns.db
mlruns/
.evidently/

# --- DVC Cache ---
.dvc/cache/
.dvc/tmp/
.dvc/config.local
.dvc/state
.dvc/lock

# --- Model & Data Artifacts ---
*.pkl
*.joblib
*.h5
*.onnx

# Data directory exclusions (keep gitkeeps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Drift reports & Temporary CSV outputs
reports/drift_*.html
*.csv.tmp
predictions_output.csv

# --- IDEs & System Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# --- Secrets ---
.env
.env.local

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
terraform.tfvars
