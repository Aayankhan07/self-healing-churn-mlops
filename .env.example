# ------------------------------------------------------------------------------
# ChurnGuard MLOps Platform — Environment Configuration Template
# Copy this file to '.env' and modify settings for local or production use.
# ------------------------------------------------------------------------------

# Application Security
API_KEY=dev-key-change-in-prod

# Service Ports & Host Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
MLFLOW_PORT=5000

# Database & MLOps Tracking Connections
DATABASE_URL=sqlite:///churnguard.db
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Model Training & Data Paths
TRAIN_DATA_PATH=data/processed/train.csv
TEST_DATA_PATH=data/processed/test.csv
MODEL_PATH=models/model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib

# Monitoring & Drift Automation
DRIFT_CHECK_EVERY=500
DRIFT_THRESHOLD=0.30
